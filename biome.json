{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["src/**", "server.ts", "tests/**"]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "off",
				"noArrayIndexKey": "off"
			},
			"style": {
				"useImportType": "off",
				"noNonNullAssertion": "off"
			},
			"a11y": {
				"useKeyWithClickEvents": "off",
				"noStaticElementInteractions": "off",
				"useButtonType": "off",
				"noSvgWithoutTitle": "off",
				"noAutofocus": "off",
				"noLabelWithoutControl": "off"
			},
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "off",
				"noUnusedFunctionParameters": "off"
			}
		}
	}
}
